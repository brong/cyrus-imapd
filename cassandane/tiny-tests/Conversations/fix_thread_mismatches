#!perl
use Cassandane::Tiny;

#
# ctl_conversationsdb -m / --fix-mismatches
#
# The same email (same GUID, hence same JMAP EmailId) must have the same
# CID in every folder.  Corrupt that invariant directly in the index, then
# check that --fix-mismatches converges every copy onto the highest CID in
# the group (including copies with a NULL CID) and drops split-conversation
# state, the way a freshly-threaded message would.
#
sub test_fix_thread_mismatches
    :min_version_3_9 :Conversations
    ($self)
{
    my $talk = $self->{store}->get_client();

    xlog $self, "create a message and copy it to two other folders";
    my $msg = $self->make_message("Message A");
    my $cidA = $msg->make_cid();
    $talk->create("foo") || die;
    $talk->create("baz") || die;
    $talk->select("INBOX");
    $talk->copy("1", "foo") || die;
    $talk->copy("1", "baz") || die;

    # a CID lower than the natural one, so INBOX (cidA) stays the winner
    $self->assert($cidA gt '0000000000000002');
    my $cidB = '0000000000000001';
    my $cidNULL = '0000000000000000';
    my $basecid = 'feedfacefeedface';

    my $foofile = $self->_index_path('user.cassandane.foo');
    my $bazfile = $self->_index_path('user.cassandane.baz');

    xlog $self, "corrupt the index copies directly";
    # drop the connection so imapd releases its cached view of the mailboxes
    $self->{store}->disconnect();

    # foo: a lower CID plus bogus split-conversation state
    $self->_set_index_cid($foofile, 1, $cidB, $basecid, 1);
    # baz: a NULL CID
    $self->_set_index_cid($bazfile, 1, $cidNULL, undef, 0);

    xlog $self, "reconstruct to repair the header CRCs we invalidated";
    # recompute the cyrus.index CRCs; reconstruct keeps the (corrupt) CIDs
    # rather than re-threading them
    $self->{instance}->run_command({ cyrus => 1 },
        'reconstruct', 'user.cassandane.foo', 'user.cassandane.baz');

    xlog $self, "resync the G records from the corrupted index records";
    # a flag change rewrites the index record, which records the (now
    # corrupt) CID into the conversations DB without re-threading
    $talk = $self->{store}->get_client();
    $talk->select("foo");
    $talk->store('1', '+flags', '(\\Flagged)') || die;
    $talk->select("baz");
    $talk->store('1', '+flags', '(\\Flagged)') || die;

    xlog $self, "confirm the mismatch was planted";
    $self->assert_str_equals($cidA, $self->_fetch_cid($talk, "INBOX", 1));
    $self->assert_str_equals($cidB, $self->_fetch_cid($talk, "foo", 1));

    xlog $self, "show mode reports the mismatches without changing anything";
    my $out = "$self->{instance}->{basedir}/showmismatches.out";
    $self->{instance}->run_command(
        { cyrus => 1, redirects => { stdout => $out } },
        'ctl_conversationsdb', '-m', 'cassandane');
    my $shown = slurp_file($out);
    $self->assert_matches(qr/CID change/, $shown);
    # nothing changed yet
    $self->assert_str_equals($cidB, $self->_fetch_cid($talk, "foo", 1));

    xlog $self, "fix the mismatches";
    $self->{instance}->run_command({ cyrus => 1 },
        'ctl_conversationsdb', '--fix-mismatches', 'cassandane');

    xlog $self, "every copy has converged onto the highest CID";
    $self->assert_str_equals($cidA, $self->_fetch_cid($talk, "INBOX", 1));
    $self->assert_str_equals($cidA, $self->_fetch_cid($talk, "foo", 1));
    $self->assert_str_equals($cidA, $self->_fetch_cid($talk, "baz", 1));

    xlog $self, "the split-conversation state on the foo copy is gone";
    my $foobasecid = $self->_fetch_basecid($talk, "foo", 1);
    $self->assert(!defined $foobasecid || $foobasecid eq '0000000000000000');
}

# the cyrus.index for a folder (a metadata file)
sub _index_path
{
    my ($self, $folder) = @_;
    my $mb = $self->{instance}->run_mbpath($folder);
    my $dir = $mb->{meta} || $mb->{data};
    die "no index dir for $folder" unless $dir;
    return "$dir/cyrus.index";
}

# set the CID (and optionally BaseCID + split-conversation flag) of a record
# directly in cyrus.index; the instance must be stopped
sub _set_index_cid
{
    my ($self, $file, $uid, $cid, $basecid, $split) = @_;

    my $fh = IO::File->new($file, "+<");
    die "NO SUCH FILE $file" unless $fh;
    my $index = Cyrus::IndexFile->new($fh);

    while (my $record = $index->next_record_hash()) {
        next unless $record->{Uid} == $uid;
        $record->{CID} = $cid;
        $record->{BaseCID} = $basecid if defined $basecid;
        # SystemFlags is an MSB-first bit string; FLAG_INTERNAL_SPLITCONVERSATION
        # is 1<<27, i.e. string index 31-27 == 4
        substr($record->{SystemFlags}, 4, 1) = '1' if $split;
        $index->rewrite_record($record);
    }
    close($fh);
}

sub _fetch_cid
{
    my ($self, $talk, $folder, $uid) = @_;
    $talk->select($folder);
    my $data = $talk->fetch($uid, '(cid)');
    return $data->{$uid}{cid};
}

sub _fetch_basecid
{
    my ($self, $talk, $folder, $uid) = @_;
    $talk->select($folder);
    my $data = $talk->fetch($uid, '(basecid)');
    return $data->{$uid}{basecid};
}
